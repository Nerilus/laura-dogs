# ===============================================
# Configuration de l'environnement de production
# ===============================================

# Port d'écoute sur la machine hôte du VPS (par défaut: 8080)
# Pointez votre reverse proxy (Nginx, Traefik, NPM) vers http://127.0.0.1:8080
APP_PORT=8080

# Image Docker à déployer (construite et poussée par la CI GitHub Actions)
DOCKER_IMAGE=ghcr.io/nerilus/laura-dogs:latest
